#!/bin/sh
# Portable entrypoint for the reconciling apply. Finds a Python >= 3.11
# (apply.py needs tomllib; macOS system Python 3.9 does not have it),
# falls back to uv, and otherwise stops with a precise message.
set -eu

SCRIPT=$0
while [ -L "$SCRIPT" ]; do
    LINK=$(readlink "$SCRIPT")
    case "$LINK" in
        /*) SCRIPT=$LINK ;;
        *) SCRIPT=$(dirname -- "$SCRIPT")/$LINK ;;
    esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
APPLY="$SCRIPT_DIR/apply.py"

for candidate in python3.13 python3.12 python3.11 python3.14 python3; do
    if command -v "$candidate" >/dev/null 2>&1; then
        if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            exec "$candidate" "$APPLY" "$@"
        fi
    fi
done

if command -v uv >/dev/null 2>&1; then
    exec uv run --python 3.14 --no-project "$APPLY" "$@"
fi

echo "error: agents-config needs Python >= 3.11 (for tomllib) or uv." >&2
echo "Install one of:" >&2
echo "  macOS:  brew install python@3.13   (or: brew install uv)" >&2
echo "  Linux:  apt install python3.12     (or: curl -LsSf https://astral.sh/uv/install.sh | sh)" >&2
exit 1
