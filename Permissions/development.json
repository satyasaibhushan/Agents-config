{
  "profiles": [
    "devbox-admin",
    "devbox-agent"
  ],
  "directories": [
    "${CODE_ROOT}",
    "${HOME}/Agents"
  ],
  "allow": [
    "Read",
    "Glob",
    "Grep",
    "Write",
    "Edit",
    "Bash",
    "WebFetch",
    "WebSearch",
    "mcp__devdock-devbox",
    "mcp__db-devbox",
    "mcp__es-devbox"
  ],
  "deny_read": [
    "**/.env*",
    "**/*.key",
    "**/*.pem",
    "**/config/secrets.json",
    "**/*.log"
  ],
  "network_access": true
}
