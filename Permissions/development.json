{
  "profiles": [
    "devbox-admin",
    "devbox-agent"
  ],
  "directories": [
    "${CODE_ROOT}",
    "${HOME}/Agents"
  ],
  "allow": [
    "Read",
    "Glob",
    "Grep",
    "Write",
    "Edit",
    "Bash",
    "Bash(env-keys *)",
    "Bash(env-hosts *)",
    "Bash(env-set *)",
    "WebFetch",
    "WebSearch",
    "mcp__devdock-devbox",
    "mcp__es-devbox"
  ],
  "deny_read": [
    "**/*.key",
    "**/*.pem",
    "**/config/secrets.json",
    "**/*.log"
  ],
  "deny_read_and_edit": [
    "**/*.env",
    "**/*.env*[!e]",
    "**/*.enve",
    "**/*.env*[!l]e",
    "**/*.envle",
    "**/*.env*[!p]le",
    "**/*.envple",
    "**/*.env*[!m]ple",
    "**/*.envmple",
    "**/*.env*[!a]mple",
    "**/*.envample",
    "**/*.env*[!x]ample",
    "**/*.envxample",
    "**/*.env*[!e]xample",
    "**/*.envexample",
    "**/*.env*[!.]example",
    "**/*.env*[!v].example",
    "**/*.envv.example",
    "**/*.env*[!n]v.example",
    "**/*.envnv.example",
    "**/*.env*[!e]nv.example",
    "**/*.envenv.example",
    "**/*.env*[!.]env.example"
  ],
  "network_access": true
}
