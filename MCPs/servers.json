{
  "version": 1,
  "servers": {
    "browser-tools": {
      "clients": ["cursor"],
      "requires": {"executables": ["npx"]},
      "config": {
        "command": "npx",
        "args": ["-y", "@agentdeskai/browser-tools-mcp@1.2.0"]
      }
    },
    "Figma": {
      "clients": ["cursor"],
      "platforms": ["darwin"],
      "setup": "Figma desktop app with the local MCP server enabled",
      "config": {
        "url": "http://127.0.0.1:3845/mcp"
      }
    },
    "db-mcp": {
      "clients": ["cursor", "claude-code", "claude-desktop", "codex"],
      "profiles": ["mac-admin", "devbox-admin", "devbox-agent"],
      "security": "reads shared databases via profiles",
      "requires": {"paths": ["${CODE_ROOT}/Personal/DB-MCP/.venv/bin/db-mcp"]},
      "setup": "clone DB-MCP under <code root>/Personal and create its .venv",
      "config": {
        "type": "stdio",
        "command": "${CODE_ROOT}/Personal/DB-MCP/.venv/bin/db-mcp",
        "args": [],
        "env": {}
      }
    },
    "elasticsearch": {
      "clients": ["cursor", "claude-code", "claude-desktop", "codex"],
      "security": "policy-enforced Elasticsearch access via named profiles",
      "requires": {
        "executables": ["uv"],
        "paths": [
          "${CODE_ROOT}/Personal/ES-MCP/pyproject.toml",
          "${HOME}/.es-access/profiles.yaml"
        ]
      },
      "setup": "clone ES-MCP under <code root>/Personal, run uv sync, and configure ~/.es-access",
      "config": {
        "type": "stdio",
        "command": "uv",
        "args": [
          "--directory",
          "${CODE_ROOT}/Personal/ES-MCP",
          "run",
          "es-mcp"
        ],
        "env": {}
      }
    },
    "new-relic": {
      "clients": ["cursor", "claude-code", "claude-desktop", "codex"],
      "profiles": ["mac-admin", "devbox-admin", "devbox-agent"],
      "security": "external service, sends queries to New Relic",
      "requires": {
        "executables": ["npx"],
        "env": ["NEW_RELIC_API_KEY"]
      },
      "config": {
        "type": "http",
        "url": "https://mcp.newrelic.com/mcp/",
        "headers": {
          "api-key": "${NEW_RELIC_API_KEY}"
        }
      },
      "codex": {
        "command": "npx",
        "args": [
          "-y",
          "mcp-remote",
          "https://mcp.newrelic.com/mcp/",
          "--header",
          "api-key:${NEW_RELIC_API_KEY}"
        ]
      },
      "claude-desktop": {
        "command": "npx",
        "args": [
          "-y",
          "mcp-remote",
          "https://mcp.newrelic.com/mcp/",
          "--header",
          "api-key:${NEW_RELIC_API_KEY}"
        ]
      }
    },
    "jira-attachments": {
      "clients": ["cursor", "claude-code", "claude-desktop", "codex"],
      "profiles": ["mac-admin", "devbox-admin", "devbox-agent"],
      "security": "reads Jira, downloads attachments locally",
      "requires": {
        "executables": ["python3"],
        "paths": ["${CODE_ROOT}/Personal/jira-attachment-downloader/mcp_server.py"]
      },
      "setup": "clone jira-attachment-downloader under <code root>/Personal",
      "config": {
        "command": "python3",
        "args": [
          "${CODE_ROOT}/Personal/jira-attachment-downloader/mcp_server.py"
        ],
        "env": {
          "JIRA_AGENT_MCP_ENV": "${MCP_ENV_PATH}"
        }
      },
      "codex": {
        "enabled": true
      }
    },
    "gmail": {
      "clients": ["claude-code", "claude-desktop"],
      "security": "reads personal Gmail",
      "requires": {"paths": ["${HOME}/.local/bin/gmail-mcp"]},
      "setup": "install gmail-mcp into ~/.local/bin and complete its OAuth flow",
      "config": {
        "type": "stdio",
        "command": "${HOME}/.local/bin/gmail-mcp",
        "args": [],
        "env": {}
      }
    },
    "sqrl": {
      "clients": ["codex", "claude-desktop"],
      "requires": {"executables": ["sqrl"]},
      "config": {
        "command": "sqrl",
        "args": ["serve", "--project", "UAT"]
      }
    },
    "devdock": {
      "platforms": ["darwin"],
      "clients": ["claude-code", "codex", "claude-desktop"],
      "security": "controls local dev containers (read-write scope)",
      "requires": {
        "executables": ["node"],
        "paths": ["${CODE_ROOT}/Personal/devdock/packages/mcp/dist/index.js"]
      },
      "setup": "clone devdock under <code root>/Personal and build packages/mcp",
      "config": {
        "type": "stdio",
        "command": "node",
        "args": [
          "${CODE_ROOT}/Personal/devdock/packages/mcp/dist/index.js"
        ],
        "env": {
          "DEVDOCK_MCP_SCOPE": "rw"
        }
      }
    },
    "devdock-devbox": {
      "codex": { "default_tools_approval_mode": "approve" },
      "clients": [
        "claude-code",
        "codex"
      ],
      "platforms": [
        "linux"
      ],
      "profiles": [
        "devbox-admin",
        "devbox-agent"
      ],
      "security": "Development operations through a scoped local socket; no host terminals or peer routing",
      "requires": {
        "executables": [
          "node"
        ],
        "paths": [
          "/srv/devdock-control/runtime/mcp/dist/index.js",
          "/srv/devdock-control/control.sock"
        ]
      },
      "config": {
        "type": "stdio",
        "command": "node",
        "args": [
          "/srv/devdock-control/runtime/mcp/dist/index.js"
        ],
        "env": {
          "DEVDOCK_SOCKET": "/srv/devdock-control/control.sock",
          "DEVDOCK_MCP_SCOPE": "rw",
          "DEVDOCK_MCP_DEVELOPMENT_ONLY": "1"
        }
      }
    },
    "db-devbox": {
      "codex": { "default_tools_approval_mode": "approve" },
      "clients": [
        "claude-code",
        "codex"
      ],
      "platforms": [
        "linux"
      ],
      "profiles": [
        "devbox-admin",
        "devbox-agent"
      ],
      "requires": {
        "paths": [
          "/usr/local/bin/vmock-mcp",
          "/run/vmock-mcp-db.sock"
        ]
      },
      "config": {
        "type": "stdio",
        "command": "/usr/local/bin/vmock-mcp",
        "args": [
          "db"
        ]
      }
    },
    "es-devbox": {
      "codex": { "default_tools_approval_mode": "approve" },
      "clients": [
        "claude-code",
        "codex"
      ],
      "platforms": [
        "linux"
      ],
      "profiles": [
        "devbox-admin",
        "devbox-agent"
      ],
      "requires": {
        "paths": [
          "/usr/local/bin/vmock-mcp",
          "/run/vmock-mcp-es.sock"
        ]
      },
      "config": {
        "type": "stdio",
        "command": "/usr/local/bin/vmock-mcp",
        "args": [
          "es"
        ]
      }
    }
  }
}
